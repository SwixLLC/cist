# Copy this file to .env and fill in the values. Never commit .env.
# These values are bundled into the public website, so use public/client keys only.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. NEVER the service_role / secret key.
VITE_SUPABASE_ANON_KEY=your-anon-key

# EmailJS → used by the contact form and the pre-registration form
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key
